{
	// Trampled filth that builds up where livestock is kept. Placed by the hygiene behavior,
	// counts as dirt, and can be shovelled up as rot. Model and texture by ReginArt (source: art/models/muck.bbmodel).
	code: "muck",
	variantgroups: [
		{ code: "level", states: ["1", "2", "3", "4"] }
	],
	creativeinventory: { "general": ["muck-1"] },
	// Breaks (dropping its rot) when the ground under it is dug out.
	behaviors: [{ name: "livestockwelfare.needsground" }],
	blockmaterial: "Soil",
	drawtype: "JSON",
	// A stepped heap on a bed, taller with each level. Turned at random in 90° steps for variety:
	// randomizeRotations turned it at any angle, so its corners poked into the neighbouring muck and flickered.
	shapebytype: {
		"*-1": { base: "block/muck/muck-1", alternates: [{ base: "block/muck/muck-1", rotateY: 90 }, { base: "block/muck/muck-1", rotateY: 180 }, { base: "block/muck/muck-1", rotateY: 270 }] },
		"*-2": { base: "block/muck/muck-2", alternates: [{ base: "block/muck/muck-2", rotateY: 90 }, { base: "block/muck/muck-2", rotateY: 180 }, { base: "block/muck/muck-2", rotateY: 270 }] },
		"*-3": { base: "block/muck/muck-3", alternates: [{ base: "block/muck/muck-3", rotateY: 90 }, { base: "block/muck/muck-3", rotateY: 180 }, { base: "block/muck/muck-3", rotateY: 270 }] },
		"*-4": { base: "block/muck/muck-4", alternates: [{ base: "block/muck/muck-4", rotateY: 90 }, { base: "block/muck/muck-4", rotateY: 180 }, { base: "block/muck/muck-4", rotateY: 270 }] }
	},
	textures: {
		all: { base: "block/muck" }
	},
	resistance: 0.3,
	lightabsorption: 0,
	// Not opaque downwards either: otherwise the block below stops drawing its top face, while the
	// muck's own bottom face is culled against it, leaving a see-through hole (x-ray).
	sideopaque: { all: false },
	sidesolid: { all: false },
	emitsideao: { all: false },
	replaceable: 6000,
	collisionbox: null,
	selectionboxbytype: {
		"*-1": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.1, z2: 1 },
		"*-2": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.1875, z2: 1 },
		"*-3": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.34, z2: 1 },
		"*-4": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.49, z2: 1 }
	},
	walkspeedmultiplierByType: {
		"*-1": 0.95,
		"*-2": 0.9,
		"*-3": 0.85,
		"*-4": 0.8
	},
	dropsByType: {
		"*-1": [{ type: "item", code: "game:rot", quantity: { avg: 1 } }],
		"*-2": [{ type: "item", code: "game:rot", quantity: { avg: 2 } }],
		"*-3": [{ type: "item", code: "game:rot", quantity: { avg: 3 } }],
		"*-4": [{ type: "item", code: "game:rot", quantity: { avg: 4 } }]
	},
	sounds: {
		place: "game:block/dirt",
		break: "game:block/dirt",
		hit: "game:block/dirt",
		walk: "game:walk/grass"
	},
	guiTransform: {
		origin: { x: 0.5, y: 0.125, z: 0.5 }
	}
}
